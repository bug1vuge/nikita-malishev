# ── Фронтенд ────────────────────────────────────────────
# Куда форма отправляет заявку. По умолчанию — серверная функция /api/lead (Vercel).
# Для PHP-хостинга укажите: /lead.php
VITE_LEAD_ENDPOINT=/api/lead

# Адрес сайта — для canonical, Open Graph и sitemap
VITE_SITE_URL=https://dambiev.ru

# ── Сервер (НЕ коммитить, задаются в панели хостинга) ──
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# ID чата/канала, куда приходят заявки (узнать: написать боту, открыть
# https://api.telegram.org/bot<TOKEN>/getUpdates и взять message.chat.id)
TELEGRAM_CHAT_ID=
