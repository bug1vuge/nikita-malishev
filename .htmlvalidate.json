{
  "extends": [
    "html-validate:recommended",
    "html-validate:document"
  ],
  "rules": {
    "void-style": "off",
    "attr-case": "off",
    "attribute-boolean-style": "off",
    "attribute-empty-style": "off",
    "doctype-style": "off",
    "no-trailing-whitespace": "off",
    "tel-non-breaking": "off",
    "no-inline-style": "off",
    "require-sri": "off",
    "prefer-native-element": [
      "error",
      {
        "exclude": [
          "listbox"
        ]
      }
    ]
  }
}