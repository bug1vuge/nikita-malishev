{
  "name": "nikita-malyshev-site",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build:client": "vite build",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir dist-ssr",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run typecheck && npm run build:client && npm run build:ssr && npm run prerender",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/onest": "^5.3.1",
    "@fontsource/unbounded": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "html-validate": "^11.16.2",
    "postcss": "^8.5.30",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3"
  },
  "private": true,
  "type": "module",
  "browserslist": [
    "> 0.5%",
    "last 2 versions",
    "Firefox ESR",
    "not dead",
    "iOS >= 14",
    "Safari >= 14"
  ]
}
